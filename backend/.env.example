# Supabase / Postgres connection
# Connection string format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face Stage-1 triage transformer
HF_TRIAGE_MODEL_NAME=google/medgemma-1.5-4b-it
HF_TRIAGE_MODEL_REVISION=main
HF_API_TOKEN=

# API-only mode: set to true if using dedicated HF Inference Endpoint
HF_USE_HOSTED_INFERENCE_API=false
HF_INFERENCE_ENDPOINT_URL=

# OSRM routing
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=3.0

# Ranking policy
RANKING_POLICY_VERSION=ranking-policy-v1
CORS_ORIGINS=http://localhost:5173

# Demo Admin Token (must match frontend VITE_DEMO_ADMIN_TOKEN)
DEMO_ADMIN_TOKEN=demo-admin-token-change-me
